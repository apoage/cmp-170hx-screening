#!/usr/bin/env bash
# Shorthand for the per-card 170HX VRAM + thermal acceptance screen.
# Installed by install.sh with @HERE@ substituted for this checkout's path.
#   hx              -> 12 min (script default)
#   hx 15           -> 15 min
#   hx 15 shelf-A3  -> 15 min, tagged
#   hx --all        -> screen every CMP 170HX in the box, one after another
#   hx --rollup     -> compare the whole batch
#   hx --card       -> card dossier: physical VRAM/SM potential, lifetime hours
set -u
SCREEN="@HERE@/bin/hx-vram-screen.sh"
CARDREPORT="@HERE@/bin/cardreport.py"

case "${1:-}" in
  --card)
    shift
    # fuse reads need root (read-only BAR0); NVML/identity works unprivileged
    if [ -f "$CARDREPORT" ]; then
      if sudo -n true 2>/dev/null; then
        exec sudo -n python3 "$CARDREPORT" "$@"
      else
        exec python3 "$CARDREPORT" "$@"
      fi
    fi
    echo "hx: $CARDREPORT not found" >&2; exit 1 ;;
  -h|--help)
    sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'
    echo "   anything else is passed to hx-vram-screen.sh (--all --parallel --gpu N)"
    exit 0 ;;
esac

exec bash "$SCREEN" "$@"
